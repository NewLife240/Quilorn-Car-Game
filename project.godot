; Engine configuration file.
config_version=5

[application]

config/name="Rusty Roads"
config/description="Build cars, haul cargo, grow an industry in the Ukrainian countryside."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DB="*res://scripts/autoload/db.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
common/physics_jitter_fix=0.0
common/physics_interpolation=true
jolt_physics_3d/simulation/max_bodies=20000

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicles"
3d_physics/layer_3="items"
3d_physics/layer_4="player"
3d_physics/layer_5="interact"

[rendering]

textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
mesh_lod/lod_change/threshold_pixels=2.0
occlusion_culling/use_occlusion_culling=false
textures/vram_compression/import_etc2_astc=false
